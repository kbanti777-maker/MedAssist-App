# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform routing and hospital map display.
# Enable the following APIs in your Google Cloud Console:
# 1. Maps JavaScript API (Interactive map, AdvancedMarker, viewport controls)
# 2. Places API (New) (Nearby hospital search, place details, photos, opening hours, contact info)
# 3. Routes API (Compute routes, distances, live travel duration and emergency navigation)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
